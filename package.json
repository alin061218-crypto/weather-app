{
    "name": "weather-backend",
    "version": "1.0.0",
    "description": "天气预报毕设后端",
    "main": "server.js",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "start": "node server.js",
        "dev": "node --watch server.js",
        "lint": "eslint server.js tests --max-warnings=0",
        "test": "vitest run",
        "format:check": "prettier --check tests README.md docs",
        "check:versions": "node server.js --check-asset-versions",
        "check:evidence": "node scripts/check-evidence.cjs",
        "backup:db": "node --env-file=.env scripts/backup-db.js"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "better-sqlite3": "^12.10.0",
        "cors": "^2.8.5",
        "express": "^4.21.0",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.2",
        "three": "^0.170.0"
    },
    "devDependencies": {
        "axe-core": "^4.13.0",
        "eslint": "^10.12.0",
        "prettier": "^3.9.9",
        "supertest": "^7.3.1",
        "vitest": "^5.0.3"
    }
}
